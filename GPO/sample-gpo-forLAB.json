    {
      "Name": "Baseline - Workstations Core",
      "Comment": "Core workstation baseline.",
      "Status": "AllSettingsEnabled",
      "WmiFilter": {
        "Name": "Windows 10 and 11 Workstations",
        "Description": "Targets client OS only",
        "Query": "SELECT * FROM Win32_OperatingSystem WHERE ProductType = '1'"
      },
      "SecurityFiltering": [
        { "TargetName": "GG-GPO-Workstations", "TargetType": "Group", "PermissionLevel": "GpoApply" }
      ],
      "RegistryPolicies": [
        { "Context": "Computer", "Key": "HKLM\\Software\\Policies\\Microsoft\\Windows\\Explorer", "ValueName": "NoAutoplayfornonVolume", "Type": "DWord", "Value": 1 },
        { "Context": "Computer", "Key": "HKLM\\Software\\Policies\\Microsoft\\Windows\\System", "ValueName": "EnableSmartScreen", "Type": "DWord", "Value": 1 }
      ],
      "Links": [
        { "Target": "OU=Workstations,DC=contoso,DC=com", "Enabled": true, "Enforced": false, "Order": 1 }
      ]
    },
    {
      "Name": "Baseline - Workstations Firewall",
